# Jenkins Controller Configuration Example
# Copy to .jenkins.env (gitignored) and populate with your credentials.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-to-a-secure-password
AWS_ACCESS_KEY_ID=AKIA_EXAMPLE_KEY_ID
AWS_SECRET_ACCESS_KEY=EXAMPLE_SECRET_ACCESS_KEY
SSM_API_KEY=example-ssm-api-key-here
