# Local development environment variables for docker-compose.yml.
# Copy to .env (gitignored) for local runs. Never commit real secrets.
APP_NAME=damolak-api
APP_ENV=local
APP_VERSION=0.1.0
GIT_SHA=local-dev
AWS_REGION=eu-north-1
LOG_LEVEL=INFO
FORWARDED_ALLOW_IPS=127.0.0.1
API_KEY=local-dev-only-replace-me
